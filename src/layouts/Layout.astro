---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'QS 聯絡人 Pool 解析' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="上傳試算表 Excel，在本機解析 QS 聯絡人 Pool 現況" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-slate-800 antialiased">
    <slot />
  </body>
</html>
